#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
	local enabled listen data_dir username password simulate
	config_load rm500u-web
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get listen main listen 'http://0.0.0.0:5080'
	config_get data_dir main data_dir '/etc/rm500u-web/data'
	config_get username main username admin
	config_get password main password admin
	config_get simulate main simulate false
	if [ -z "$username" ]; then
		logger -t rm500u-web 'Set a nonempty UCI username before starting.'
		return 1
	fi
	if [ -z "$password" ]; then
		password=admin
		uci set "rm500u-web.main.password=$password" || return 1
		uci commit rm500u-web || return 1
	fi
	chmod 0600 /etc/config/rm500u-web
	mkdir -p "$data_dir" || return 1
	chmod 0700 "$data_dir"
	procd_open_instance
	procd_set_param command /usr/lib/rm500u-web/RM500U.Web --contentRoot /usr/lib/rm500u-web
	procd_set_param env "ASPNETCORE_URLS=$listen" "ASPNETCORE_ENVIRONMENT=Production" \
		"LD_LIBRARY_PATH=/usr/lib/rm500u-web" \
		"DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1" "RM500U_DATA_DIR=$data_dir" \
		"RM500U_WEB_USER=$username" "RM500U_WEB_PASSWORD=$password" "RM500U_SIMULATE=$simulate"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/rm500u-web
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger rm500u-web
}
